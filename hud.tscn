[gd_scene format=3 uid="uid://dld00e2a7oyus"]

[sub_resource type="GDScript" id="GDScript_oshh3"]
script/source = "extends CanvasLayer

@onready var coin_label: Label = $CoinLabel
@onready var win_label: Label = $WinLabel

func _ready() -> void:
	win_label.hide()

func update_coins(count: int, needed: int) -> void:
	coin_label.text = \"Coins: %d / %d\" % [count, needed]

func show_win() -> void:
	win_label.show()
	await get_tree().create_timer(3.0).timeout
	get_tree().reload_current_scene()
"

