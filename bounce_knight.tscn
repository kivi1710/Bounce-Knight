[sub_resource type="GDScript" id="GDScript_oshh3"]
script/source = "extends CharacterBody2D

const GAME_OVER = preload(\"res://game_over_screen.tscn\")
var dead := false

const SPEED = 150.0
const JUMP_VELOCITY = -400.0
@onready var bounce_knight_anim: AnimatedSprite2D = $BounceKnight_Anim

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY
		bounce_knight_anim.play(\"jump\")
	
	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"move_left\", \"move_right\")
	
	if direction > 0:
		bounce_knight_anim.flip_h = false
		bounce_knight_anim.play(\"idle\")
	if direction < 0:
		bounce_knight_anim.flip_h = true
		bounce_knight_anim.play(\"idle\")
	
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
	
func _ready() -> void:
	add_to_group(\"player\")

func die() -> void:
	if dead:
		return
	dead = true
	set_physics_process(false)
	get_tree().current_scene.add_child(GAME_OVER.instantiate())
	await get_tree().create_timer(2.0).timeout
	get_tree().reload_current_scene()

func bounce() -> void:
	velocity.y = JUMP_VELOCITY * 0.7
	
	
	
"

